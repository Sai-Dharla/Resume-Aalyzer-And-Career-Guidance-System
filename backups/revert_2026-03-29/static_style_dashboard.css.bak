:root{
  --bg-1:#071127; /* deep */
  --card-bg: rgba(255,255,255,0.04);
  --glass-border: rgba(255,255,255,0.06);
  --neon1: #7c3aed; /* purple */
  --neon2: #3b82f6; /* blue */
  --neon3: #10b981; /* green */
}
*{box-sizing:border-box}
body.dash-root, body{margin:0;font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Roboto,Arial;color:#e6eef8;background:linear-gradient(180deg,var(--bg-1) 0%, #031027 100%);min-height:100vh}
.dash-root{display:flex;gap:24px}
.sidebar{width:260px;padding:28px 20px;background:linear-gradient(180deg,rgba(3,10,23,0.7),rgba(6,15,33,0.6));backdrop-filter:blur(8px);border-radius:14px;margin:18px;height:calc(100vh - 36px);display:flex;flex-direction:column;justify-content:space-between;border-left:4px solid rgba(124,58,237,0.06);box-shadow:inset 0 0 80px rgba(59,130,246,0.04),0 10px 40px rgba(2,6,23,0.6)}
.profile{display:flex;flex-direction:column;align-items:center;gap:12px}
.avatar{width:84px;height:84px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:linear-gradient(90deg,rgba(255,255,255,0.06),rgba(255,255,255,0.02));color:#e6eef8;border:3px solid rgba(59,130,246,0.18);box-shadow:0 6px 30px rgba(59,130,246,0.06);font-size:26px}
.name{font-weight:800;color:#dbeafe}
.menu{margin-top:24px;display:flex;flex-direction:column;gap:8px}
.menu-item{padding:14px 14px;border-radius:12px;color:#bcd7ef;text-decoration:none;cursor:pointer;position:relative;transition:all .28s ease}
.menu-item:hover{transform:translateX(8px);color:white}
.menu-item.active{background:linear-gradient(90deg,rgba(124,58,237,0.11),rgba(59,130,246,0.06));box-shadow:0 12px 40px rgba(59,130,246,0.06);border:1px solid rgba(124,58,237,0.18);outline:2px solid rgba(59,130,246,0.06)}
.sidebar-footer{display:flex;justify-content:center}
.logout{background:transparent;border:1px solid rgba(255,255,255,0.06);padding:8px 12px;border-radius:10px;color:#dbeafe;cursor:pointer}

.main-area{flex:1;padding:22px 28px 40px;display:flex;flex-direction:column;gap:20px}
.top-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{position:relative;padding:18px;border-radius:16px;background:var(--card-bg);backdrop-filter:blur(8px);border:1px solid var(--glass-border);overflow:hidden;box-shadow:0 8px 40px rgba(2,6,23,0.6);transition:transform .3s ease, box-shadow .3s ease}
.card:hover{transform:translateY(-6px);box-shadow:0 18px 60px rgba(59,130,246,0.12)}
.card-border{position:absolute;inset:0;border-radius:16px;padding:1px;pointer-events:none}
.card-border:before{content:"";position:absolute;inset:-2px;background:linear-gradient(90deg,var(--neon1),var(--neon2),var(--neon3));filter:blur(18px);opacity:0.45}
.card-body{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}
.big-number{font-size:36px;font-weight:800;color:#ecfeff}
.card-title{font-weight:700;color:#cfe8ff}
.card-sub{font-size:13px;color:#94a3b8}

.readiness canvas{display:block}

.middle-grid{display:grid;grid-template-columns:1fr 380px;gap:18px}
.chart-card{display:flex;flex-direction:column;gap:12px}
.card-head{display:flex;justify-content:space-between;align-items:center}
.tags{display:flex;gap:8px}
.tag{padding:6px 8px;border-radius:8px;background:rgba(255,255,255,0.02);font-weight:700}
.tag.pos{color:var(--neon3);border:1px solid rgba(16,185,129,0.12)}
.card-content{height:220px}
.card-actions{display:flex;justify-content:flex-end;margin-top:6px}
.btn{padding:10px 14px;border-radius:10px;cursor:pointer;border:1px solid rgba(255,255,255,0.04);transition:transform .2s ease}
.btn.primary{background:linear-gradient(90deg,var(--neon2),var(--neon3));color:#021}
.btn.primary:hover{transform:scale(1.03)}
.btn.outline{background:transparent;border:1px solid rgba(255,255,255,0.06);color:#e6eef8}

.milestones .flow{display:flex;gap:8px;align-items:center;color:#dbeafe;margin:12px 0}
.progress{background:rgba(255,255,255,0.03);height:10px;border-radius:999px;overflow:hidden}
.progress-bar{height:100%;background:linear-gradient(90deg,var(--neon1),var(--neon2));box-shadow:0 6px 20px rgba(59,130,246,0.08)}
.progress-label{font-size:13px;color:#94a3b8;margin-top:8px}

.bottom-grid{display:grid;grid-template-columns:360px 1fr;gap:18px}
.profile-summary{padding:18px}
.skills .skill-list{display:flex;flex-direction:column;gap:12px}
.skill{display:flex;align-items:center;justify-content:space-between;padding:10px 14px;border-radius:10px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.02)}
.skill-info{display:flex;gap:12px;align-items:center}
.skill-name{font-weight:700;color:#e6eef8}
.skill-meta{font-size:13px;color:#9fb6d9;padding:4px 8px;border-radius:8px;background:rgba(255,255,255,0.02)}
.skill-bar{flex-basis:40%;height:8px;background:rgba(255,255,255,0.02);border-radius:999px;margin-left:12px;margin-right:12px;overflow:hidden}
.skill-bar > div{height:100%;background:linear-gradient(90deg,var(--neon3),var(--neon2))}

.centered-footer{margin-top:18px;padding:12px 18px;border-radius:12px;align-self:center;background:linear-gradient(90deg,rgba(255,255,255,0.01),rgba(255,255,255,0.00));color:#9fb6d9;border:1px solid rgba(255,255,255,0.03)}

/* Responsive */
@media (max-width:1000px){.middle-grid{grid-template-columns:1fr}.top-cards{grid-template-columns:1fr}.bottom-grid{grid-template-columns:1fr}.sidebar{display:none}.dash-root{padding:12px}}